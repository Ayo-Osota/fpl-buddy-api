# Django
DJANGO_SECRET_KEY=change-me-locally
DJANGO_DEBUG=True

# Postgres (local dev instance — see docs/architecture.md for how to run one via Docker)
DATABASE_NAME=fpl_buddy
DATABASE_USER=fpl_buddy
DATABASE_PASSWORD=fpl_buddy
DATABASE_HOST=localhost
DATABASE_PORT=5432

# FPL public API
FPL_API_BASE_URL=https://fantasy.premierleague.com/api

# FPL data cache freshness window, in seconds
FPL_CACHE_TTL_SECONDS=3600
